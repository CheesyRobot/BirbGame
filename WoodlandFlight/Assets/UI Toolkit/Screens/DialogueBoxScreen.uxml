<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MenusTheme.uss?fileID=7433441132597879392&amp;guid=a76cf53ccdf7e994c975f797845f1d3d&amp;type=3#MenusTheme" />
    <engine:VisualElement name="DialogueBox" class="PanelBackground" style="flex-grow: 0; height: 100%; flex-direction: column; width: 100%; align-items: flex-start; align-self: center; background-color: rgba(255, 255, 255, 0.71); border-left-color: rgb(27, 141, 153); border-right-color: rgb(27, 141, 153); border-top-color: rgb(27, 141, 153); border-bottom-color: rgb(27, 141, 153); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; padding-top: 1.5%; padding-right: 2%; padding-bottom: 0.5%; padding-left: 2%; justify-content: flex-start; bottom: 0; position: absolute;">
        <engine:Label text="Name owo&#10;" name="Name" class="TextFont" style="color: rgb(0, 0, 0); font-size: 50px;" />
        <engine:Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean et lobortis sem. Integer non nunc at libero porta iaculis. Maecenas et neque est. Morbi tempus leo vitae lobortis finibus. Vestibulum aliquet lobortis consectetur. Nullam tincidunt venenatis eros, id fringilla sem tincidunt ac. Sed faucibus lacinia auctor. Vestibulum ornare lectus velit, non" double-click-selects-word="false" triple-click-selects-line="false" name="Dialogue" class="ParagraphFont" style="flex-shrink: 1; width: 100%; height: 100%; flex-grow: 0; overflow: hidden;" />
        <engine:Label text="Press Enter to continue&#10;" name="EnterContinue" class="ParagraphFont" style="align-self: flex-end; font-size: 26px;" />
    </engine:VisualElement>
</engine:UXML>
