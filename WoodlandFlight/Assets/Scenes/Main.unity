--- !u!114 &820107480
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 820107477}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87a948977d4e7bc4692bda67c6b67132, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npc: {fileID: 1358313933}
  dialogueLines:
  - Hello! You want help scaring off the campers?
  - That's a big ask... Let me think about it.
  - Are the campers with guns still there? No? Okay.
  - Tell you what. I'm hungry. If you can bring me three fish, I will help you out!
