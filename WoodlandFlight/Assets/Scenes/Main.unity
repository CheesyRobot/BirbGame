--- !u!114 &703903305
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 703903296}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87a948977d4e7bc4692bda67c6b67132, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npc: {fileID: 1339490777}
  dialogueLines:
  - Hello Livia! Did our plan with the letter work?
  - Oh it did? That's great!
  - How to make the others leave, you ask? Hmmm...
  - I don't know.. Maybe you can annoy them somehow to make them leave?
  - You should look if there's anything to make use of in the Camp.  If that doesn't
    work, you could ask the bear for help.
--- !u!114 &703903306
